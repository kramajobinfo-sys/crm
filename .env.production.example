APP_NAME="Krama CRM"
APP_ENV=production
APP_KEY=REPLACE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=https://crm.example.com
APP_DOMAIN=example.com
APP_LOCALE=en

APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
FRONTEND_URL=https://crm.example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=krama_crm
DB_USERNAME=krama
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD

CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_TTL=15
JWT_REFRESH_TTL=10080
JWT_BLACKLIST_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

TWO_FACTOR_ISSUER="Krama CRM"

DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT=production

