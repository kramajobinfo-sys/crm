APP_NAME="Krama CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_DOMAIN=localhost
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=krama_crm
DB_USERNAME=krama
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redissecret

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=10080
JWT_BLACKLIST_ENABLED=true

# FRONTEND_URL is optional now — CORS accepts any LAN IP origin by regex.
# Pin it only if you want to lock down to one origin, e.g.:
# FRONTEND_URL=http://192.168.1.50:8080
FRONTEND_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@krama.local"
MAIL_FROM_NAME="${APP_NAME}"

TWO_FACTOR_ISSUER="Krama CRM"

# Dynamics 365 Business Central (Module 17).
# Preferred over storing the secret in bc_connections: a DB dump plus APP_KEY
# would otherwise expose it. Leave blank to configure per-connection instead.
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT=production
